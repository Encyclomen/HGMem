    <node id="FAIRYLAND OF BEAUTY">
      <data key="d0">CONCEPT</data>
      <data key="d1">Fairyland of Beauty refers to the breathtaking and indescribable landscape encountered upon emerging from the elevator, featuring vibrant flora and jewel-paved paths.</data>
