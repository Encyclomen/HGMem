      <data key="d2">chunk-e401d5c5533e509190fb60ba8bfa478f</data>
    </node>
    <node id="WONDROUS STATUE">
      <data key="d0">CONCEPT</data>
      <data key="d1">A Wondrous Statue is a statue carved from a living ruby, present at the battlefield.&lt;SEP&gt;Wondrous Statue is a statue carved from living ruby, present in the battle scene, indicating its significance.</data>
