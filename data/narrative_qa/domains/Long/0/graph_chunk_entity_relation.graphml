      <data key="d2">chunk-e678ea71ac9a1264539f43637bf2a809</data>
    </node>
    <node id="PARTING INSTRUCTIONS">
      <data key="d0">EVENT</data>
      <data key="d1">Parting Instructions refer to the guidance given by the narrator to Carthoris and Xodar in case the narrator does not return.</data>
