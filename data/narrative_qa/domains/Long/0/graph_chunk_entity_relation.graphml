      <data key="d2">chunk-796965d281b54a5d433ef73d41710652</data>
    </node>
    <node id="DANGEROUS CORRIDOR">
      <data key="d0">GEO</data>
      <data key="d1">The Dangerous Corridor is a diverging path where soldiers face a life-threatening situation due to rising water levels.</data>
